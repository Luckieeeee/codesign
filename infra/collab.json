{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.42.1.51946",
      "templateHash": "11632882950846317527"
    }
  },
  "parameters": {
    "appName": {
      "type": "string",
      "defaultValue": "codesign",
      "metadata": {
        "description": "Base name for all resources (e.g. \"codesign\")"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for all resources"
      }
    },
    "containerImage": {
      "type": "string",
      "metadata": {
        "description": "Container image to deploy (e.g. \"codesignacr7d7dff4b.azurecr.io/codesign-collab:abc1234\")"
      }
    },
    "acrLoginServer": {
      "type": "string",
      "metadata": {
        "description": "ACR login server (e.g. \"codesignacr7d7dff4b.azurecr.io\")"
      }
    },
    "acrUsername": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "ACR username (admin user). Empty = use managed identity instead."
      }
    },
    "acrPassword": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "ACR admin password. Empty = use managed identity instead."
      }
    },
    "supabaseUrl": {
      "type": "securestring",
      "metadata": {
        "description": "Supabase project URL (e.g. https://xxx.supabase.co)"
      }
    },
    "supabaseServiceRoleKey": {
      "type": "securestring",
      "metadata": {
        "description": "Supabase service role key (server-side only)"
      }
    },
    "cpuCores": {
      "type": "string",
      "defaultValue": "0.5",
      "allowedValues": [
        "0.25",
        "0.5",
        "1",
        "2"
      ],
      "metadata": {
        "description": "CPU cores for the container"
      }
    },
    "memoryGi": {
      "type": "string",
      "defaultValue": "1",
      "allowedValues": [
        "0.5",
        "1",
        "2",
        "4"
      ],
      "metadata": {
        "description": "Memory in Gi for the container"
      }
    },
    "minReplicas": {
      "type": "int",
      "defaultValue": 1,
      "minValue": 0,
      "maxValue": 10,
      "metadata": {
        "description": "Minimum number of replicas. Keep at 1 unless using Redis-backed Hocuspocus — multiple replicas without sticky sessions will fork Y.Doc state."
      }
    },
    "maxReplicas": {
      "type": "int",
      "defaultValue": 1,
      "minValue": 1,
      "maxValue": 10,
      "metadata": {
        "description": "Maximum number of replicas. See note on minReplicas."
      }
    },
    "collabPort": {
      "type": "int",
      "defaultValue": 1234,
      "metadata": {
        "description": "Internal TCP port the collab server listens on (matches COLLAB_WS_PORT)"
      }
    },
    "allowedOrigins": {
      "type": "array",
      "defaultValue": [
        "*"
      ],
      "metadata": {
        "description": "CORS allowed origins. Use [\"*\"] for hackathon, narrow to Vercel domain for prod."
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2023-09-01",
      "name": "[format('{0}-collab-logs', parameters('appName'))]",
      "location": "[parameters('location')]",
      "properties": {
        "sku": {
          "name": "PerGB2018"
        },
        "retentionInDays": 30
      }
    },
    {
      "type": "Microsoft.App/managedEnvironments",
      "apiVersion": "2024-03-01",
      "name": "[format('{0}-collab-env', parameters('appName'))]",
      "location": "[parameters('location')]",
      "properties": {
        "appLogsConfiguration": {
          "destination": "log-analytics",
          "logAnalyticsConfiguration": {
            "customerId": "[reference(resourceId('Microsoft.OperationalInsights/workspaces', format('{0}-collab-logs', parameters('appName'))), '2023-09-01').customerId]",
            "sharedKey": "[listKeys(resourceId('Microsoft.OperationalInsights/workspaces', format('{0}-collab-logs', parameters('appName'))), '2023-09-01').primarySharedKey]"
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', format('{0}-collab-logs', parameters('appName')))]"
      ]
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "[format('{0}-collab', parameters('appName'))]",
      "location": "[parameters('location')]",
      "properties": {
        "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', format('{0}-collab-env', parameters('appName')))]",
        "configuration": {
          "activeRevisionsMode": "Single",
          "registries": "[if(empty(parameters('acrUsername')), createArray(), createArray(createObject('server', parameters('acrLoginServer'), 'username', parameters('acrUsername'), 'passwordSecretRef', 'acr-password')))]",
          "secrets": "[concat(if(empty(parameters('acrPassword')), createArray(), createArray(createObject('name', 'acr-password', 'value', parameters('acrPassword')))), createArray(createObject('name', 'supabase-url', 'value', parameters('supabaseUrl')), createObject('name', 'supabase-service-role-key', 'value', parameters('supabaseServiceRoleKey'))))]",
          "ingress": {
            "external": true,
            "targetPort": "[parameters('collabPort')]",
            "transport": "auto",
            "stickySessions": {
              "affinity": "sticky"
            },
            "corsPolicy": {
              "allowedOrigins": "[parameters('allowedOrigins')]",
              "allowedMethods": [
                "GET",
                "POST",
                "OPTIONS"
              ],
              "allowedHeaders": [
                "*"
              ]
            }
          }
        },
        "template": {
          "containers": [
            {
              "name": "collab-server",
              "image": "[parameters('containerImage')]",
              "resources": {
                "cpu": "[json(parameters('cpuCores'))]",
                "memory": "[format('{0}Gi', parameters('memoryGi'))]"
              },
              "env": [
                {
                  "name": "SUPABASE_URL",
                  "secretRef": "supabase-url"
                },
                {
                  "name": "SUPABASE_SERVICE_ROLE_KEY",
                  "secretRef": "supabase-service-role-key"
                },
                {
                  "name": "COLLAB_WS_PORT",
                  "value": "[string(parameters('collabPort'))]"
                },
                {
                  "name": "COLLAB_WS_HOST",
                  "value": "0.0.0.0"
                },
                {
                  "name": "NODE_ENV",
                  "value": "production"
                }
              ],
              "probes": [
                {
                  "type": "Liveness",
                  "httpGet": {
                    "port": "[parameters('collabPort')]",
                    "path": "/health"
                  },
                  "initialDelaySeconds": 10,
                  "periodSeconds": 30,
                  "failureThreshold": 3
                },
                {
                  "type": "Readiness",
                  "httpGet": {
                    "port": "[parameters('collabPort')]",
                    "path": "/health"
                  },
                  "initialDelaySeconds": 5,
                  "periodSeconds": 10,
                  "failureThreshold": 3
                }
              ]
            }
          ],
          "scale": {
            "minReplicas": "[parameters('minReplicas')]",
            "maxReplicas": "[parameters('maxReplicas')]"
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', format('{0}-collab-env', parameters('appName')))]"
      ]
    }
  ],
  "outputs": {
    "collabAppFqdn": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.App/containerApps', format('{0}-collab', parameters('appName'))), '2024-03-01').configuration.ingress.fqdn]"
    },
    "collabWsUrl": {
      "type": "string",
      "value": "[format('wss://{0}', reference(resourceId('Microsoft.App/containerApps', format('{0}-collab', parameters('appName'))), '2024-03-01').configuration.ingress.fqdn)]"
    },
    "collabHttpUrl": {
      "type": "string",
      "value": "[format('https://{0}', reference(resourceId('Microsoft.App/containerApps', format('{0}-collab', parameters('appName'))), '2024-03-01').configuration.ingress.fqdn)]"
    },
    "environmentId": {
      "type": "string",
      "value": "[resourceId('Microsoft.App/managedEnvironments', format('{0}-collab-env', parameters('appName')))]"
    }
  }
}