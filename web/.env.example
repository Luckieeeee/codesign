NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-side Supabase access used by the collab websocket server (writes
# Yjs document state and project metadata). Never ship this to the browser.
# Supabase dashboard → Project Settings → API → service_role key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback

NEXT_PUBLIC_COLLAB_WS_URL=ws://localhost:1234
NEXT_PUBLIC_COLLAB_HTTP_URL=http://localhost:1234

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=

# ---- Agent bridge -----------------------------------------------------------
# When set, every agent-bridge HTTP request must present this secret as
# either `Authorization: Bearer <secret>` or `X-Agent-Token: <secret>`.
# Required when COLLAB_WS_HOST is anything other than 127.0.0.1.
CODESIGN_AGENT_BRIDGE_SECRET=
# Comma-separated list of allowed CORS origins. Ignored in loopback-only
# mode (when no secret is set + COLLAB_WS_HOST=127.0.0.1).
CODESIGN_AGENT_BRIDGE_ORIGINS=
# `memory` (default) → idempotency cache lives in process memory; POST /edit
# requests carrying `Idempotency-Key` are deduplicated for ~10 min per
# (project, agent, key).
# `off` → idempotency cache is disabled; `Idempotency-Key` headers are ignored.
# Any value other than `off` is treated as `memory`.
CODESIGN_AGENT_BRIDGE_IDEMPOTENCY_MODE=memory
