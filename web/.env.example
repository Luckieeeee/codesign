NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-side Supabase access used by the collab websocket server (writes
# Yjs document state and project metadata). Never ship this to the browser.
# Supabase dashboard → Project Settings → API → service_role key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback

NEXT_PUBLIC_COLLAB_WS_URL=ws://localhost:1234
NEXT_PUBLIC_COLLAB_HTTP_URL=http://localhost:1234
